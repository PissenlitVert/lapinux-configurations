{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PissenlitVert/lapinux-configurations/main/schema/catalog.schema.json",
  "title": "Lapinux configuration catalog",
  "description": "Generated by tools/catalog.py. Do not edit catalog.json by hand. Each entry is a configuration manifest plus the generated 'base' and 'size' fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "maintainer",
    "configurations"
  ],
  "properties": {
    "version": {
      "const": 2,
      "description": "Catalog format. Lapinux accepts older catalogs but always publishes version 2."
    },
    "maintainer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "github": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+$"
        }
      }
    },
    "configurations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "type",
          "platform",
          "author",
          "version",
          "license",
          "game",
          "actions",
          "base"
        ],
        "properties": {
          "base": {
            "type": "string",
            "pattern": "^configurations/[a-z0-9-]+/[a-z0-9-]+$",
            "description": "Repository folder of the entry; files are fetched relative to it."
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "description": "Total size of the entry's files, in bytes."
          }
        },
        "description": "A configuration manifest plus the generated fields. Validate one entry with schema/configuration.schema.json."
      }
    },
    "themes": {
      "type": "array",
      "description": "Declarative interface themes. Each entry points to a declarative .theme manifest and its SHA-256; no code is executed.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "author",
          "version",
          "license",
          "status",
          "file",
          "sha256",
          "size"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "author": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "github": {
                "type": "string",
                "pattern": "^[A-Za-z0-9-]+$"
              }
            }
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "verified",
              "experimental",
              "broken"
            ]
          },
          "file": {
            "type": "string",
            "pattern": "^themes/[a-z0-9_-]+\\.theme$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 262144
          }
        }
      }
    },
    "plugins": {
      "type": "array",
      "description": "Native plugin and theme libraries. Each entry points to its .so and carries its metadata here; no manifest file is published.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "author",
          "version",
          "license",
          "status",
          "binary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "author": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "github": {
                "type": "string",
                "pattern": "^[A-Za-z0-9-]+$"
              }
            }
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "verified",
              "experimental",
              "broken"
            ]
          },
          "theme": {
            "type": "boolean",
            "description": "The plugin provides an interface theme and is listed with themes rather than plugins."
          },
          "binary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "sha256",
              "size"
            ],
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^(plugins|themes)/[A-Za-z0-9._-]+\\\\.so$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 67108864
              }
            },
            "description": "The published native library; installed beside a manifest generated locally by Lapinux."
          },
          "abi": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64,
            "description": "ABI native du binaire (lapinux-plugin-api HOST_ABI_VERSION). Lapinux refuse une autre version."
          },
          "arch": {
            "type": "string",
            "enum": [
              "x86_64",
              "aarch64",
              "any"
            ],
            "description": "Architecture du binaire. Lapinux refuse celle d'une autre machine."
          },
          "min_lapinux_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "description": "Version minimale de Lapinux, quand le plugin en exige une."
          }
        }
      }
    },
    "palettes": {
      "type": "array",
      "description": "Palettes de couleurs (données pures, sans binaire).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "colors"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "author": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "github": {
                "type": "string",
                "pattern": "^[A-Za-z0-9-]+$"
              }
            }
          },
          "version": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "verified",
              "experimental",
              "broken"
            ]
          },
          "colors": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "background",
              "panel",
              "card",
              "card_hover",
              "card_active",
              "border",
              "accent",
              "text",
              "text_dim"
            ],
            "properties": {
              "background": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "panel": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "card": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "card_hover": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "card_active": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "border": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "accent": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "text": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "text_dim": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            }
          }
        }
      }
    }
  }
}
